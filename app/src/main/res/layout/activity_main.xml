<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/calculator_bg"
    android:padding="8dp"
    tools:context=".MainActivity">

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000" />

    <LinearLayout
        android:id="@+id/headerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="12dp">

        <TextView
            android:id="@+id/txtAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Scientific Calculator"
            android:textColor="#00E5FF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <TextView
        android:id="@+id/txtHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/headerSection"
        android:gravity="end"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:text=""
        android:textColor="#94A3B8"
        android:textSize="14sp"
        android:fontFamily="monospace" />

    <TextView
        android:id="@+id/txtDisplay"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_below="@id/txtHistory"
        android:layout_marginTop="4dp"
        android:layout_marginHorizontal="8dp"
        android:background="#102233"
        android:textColor="#00E5FF"
        android:textSize="44sp"
        android:gravity="end|center_vertical"
        android:padding="16dp"
        android:text="0"
        android:fontFamily="monospace"
        android:elevation="4dp"
        android:singleLine="true" />

    <LinearLayout
        android:id="@+id/footerSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:gravity="center"
        android:padding="10dp"
        android:orientation="vertical">

        <View
            android:layout_width="80dp"
            android:layout_height="1dp"
            android:background="#33FFFFFF"
            android:layout_marginBottom="6dp"/>

        <TextView
            android:id="@+id/txtDevName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Developed by: Goutam Gupta"
            android:textColor="#94A3B8"
            android:textSize="11sp"
            android:textStyle="italic"
            android:textAllCaps="true" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/txtDisplay"
        android:layout_above="@id/footerSection"
        android:layout_marginTop="12dp"
        android:fillViewport="true"
        android:scrollbars="none">

        <GridLayout
            android:id="@+id/calculatorGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="4"
            android:padding="2dp">

            <Button android:text="C" android:onClick="onClear" style="@style/CalcButton"
                android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="DEL" android:onClick="onDelete" style="@style/CalcButton"
                android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="=" android:onClick="onEquals" style="@style/CalcButton"
                android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="/" android:onClick="onButtonClick" style="@style/CalcButton"
                android:layout_columnWeight="1" android:layout_margin="4dp"/>

            <Button android:text="7" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="8" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="9" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="*" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>

            <Button android:text="4" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="5" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="6" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="-" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>

            <Button android:text="1" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="2" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="3" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="+" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>

            <Button android:text="0" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="." android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="π" android:onClick="onConstantClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="e" android:onClick="onConstantClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>

            <Button android:text="sin" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="cos" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="tan" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="log" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>

            <Button android:text="h" android:onClick="onConstantClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="c" android:onClick="onConstantClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="G" android:onClick="onConstantClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="√" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>

            <Button android:text="bin()" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="hex()" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="oct()" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>
            <Button android:text="x²" android:onClick="onButtonClick" style="@style/CalcButton" android:layout_columnWeight="1" android:layout_margin="4dp"/>

        </GridLayout>
    </ScrollView>

</RelativeLayout>