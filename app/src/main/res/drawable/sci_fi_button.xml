<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <corners android:radius="8dp" />
            <gradient
                android:startColor="#CC00E5FF"
                android:endColor="#66004D40"
                android:angle="270" />
            <stroke android:width="2dp" android:color="#FFFFFF" />
        </shape>
    </item>

    <item>
        <layer-list>
            <item android:top="2dp" android:left="1dp">
                <shape>
                    <corners android:radius="8dp" />
                    <solid android:color="#40000000" />
                </shape>
            </item>
            <item android:bottom="2dp" android:right="1dp">
                <shape>
                    <corners android:radius="8dp" />
                    <gradient
                        android:startColor="#55FFFFFF"
                        android:centerColor="#1AFFFFFF"
                        android:endColor="#00000000"
                        android:angle="270" />
                    <stroke android:width="1dp" android:color="#4DFFFFFF" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>